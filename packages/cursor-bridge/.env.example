# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Cursor API Configuration
# Option 1: Use Cursor API with API key
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_API_URL=https://api.cursor.sh

# Option 2: Use Cursor webhook URL (if Cursor exposes a webhook endpoint)
CURSOR_WEBHOOK_URL=https://your-cursor-instance.com/webhook

# Slack Configuration
# Option 1: Use Slack Bot Token (for full API access)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#mpdm-omid--clawdbot_app--cursor-1

# Option 2: Use Slack Webhook URL (simpler, for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_NOTIFICATIONS_ENABLED=true
